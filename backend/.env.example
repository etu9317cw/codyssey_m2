# ---- 저장소 ----
# memory: JSON 파일(backend/data/store.local.json)에 저장, Firebase 없이 동작 (로컬·채점용 기본값)
# firestore: 아래 Firebase 변수 필요
STORAGE=memory

# ---- LLM (둘 중 한 이름만 있으면 됨) ----
# 기관 프록시(OpenAI 호환) 키. 또는 개인 OpenAI 키를 OPENAI_API_KEY 에 넣고 OPENAI_BASE_URL 을 비우면 OpenAI 로 간다
OPENAI_API_KEY=
OPENAI_BASE_URL=https://copa.codyssey.kr
LLM_MODEL=gemini-3-flash
LLM_TIMEOUT=20

# ---- Firebase (STORAGE=firestore 일 때) : 방법 A 또는 B ----
# A) 서비스 계정 JSON 파일 경로 또는 JSON 문자열 한 줄
FIREBASE_SERVICE_ACCOUNT_JSON=
# B) 3개 변수로 분해 (Render 환경변수에 올리기 쉬움). PRIVATE_KEY 의 줄바꿈은 \n 으로
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ---- CORS·표시 ----
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
DATA_LABEL=센터 교육동 일별 전력 사용량
DATA_UNIT=kWh
